# Copy this file to .env.local and fill in your values.
# .env.local is gitignored and will not be committed.

# URL of your local AYON server instance.
# All /api requests from the Vite dev server are proxied here.
SERVER_URL=http://localhost:5000

# Set to "true" to bypass the AYON API entirely and use mock data.
# Useful for pure frontend development without a running server.
# VITE_USE_MOCK_DATA=true
